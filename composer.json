{
    "name": "belej-consulting/lettie-dgda",
    "description": "Lettie-DGDA — gestion et traçabilité des correspondances de la DGDA",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "chillerlan/php-qrcode": "^5.0",
        "dompdf/dompdf": "^3.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": { "phpunit/phpunit": "^11.5" },
    "autoload": { "psr-4": { "App\\": "app/" }, "files": ["app/Core/helpers.php"] },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": { "migrate": "php bin/migrate.php", "test": "phpunit" },
    "config": { "sort-packages": true }
}
