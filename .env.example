APP_NAME="Lettie-DGDA"
APP_ENV=local
APP_DEBUG=true
APP_BASE_PATH=/Lettie-DGDA
APP_URL=http://127.0.0.1/Lettie-DGDA
# Chiffre le mot de passe SMTP en base : php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Premier id de mail_events scellé avec APP_KEY. Nouvelle installation : 0
EVENT_SEAL_FROM=0
APP_LOCALE=fr
APP_TIMEZONE=Africa/Lubumbashi

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lettie_dgda_app
DB_USER=root
DB_PASS=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com

# Organisation (en-têtes des documents)
ORG_NAME="Direction Générale des Douanes et Accises"
ORG_SHORT=DGDA
ORG_CITY="Katanga, RDC"
